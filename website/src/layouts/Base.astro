---
const { title, description } = Astro.props as { title: string; description: string }
const datafastQueue =
  'window.datafast=window.datafast||function(){window.datafast.q=window.datafast.q||[];window.datafast.q.push(arguments);};'
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f2f2f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://simplefest.app/icon.png" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {
      import.meta.env.PROD && (
        <>
          <script is:inline id="datafast-queue" set:html={datafastQueue}></script>
          <script
            is:inline
            defer
            data-website-id="dfid_SOxfeZxKQPOvpRGoWC6YI"
            data-domain="simplefest.app"
            src="https://datafa.st/js/script.js"
          ></script>
        </>
      )
    }
  </head>
  <body>
    <header class="bar">
      <a class="brand" href="/"><img src="/icon.png" alt="" width="32" height="32" />Simple Fest</a>
      <nav>
        <a href="/#ticket">Guest QR</a>
        <a href="/support/">Support</a>
      </nav>
    </header>
    <slot />
    <footer>
      <span>Free and open source · Digital Shift OÜ</span>
      <nav>
        <a href="https://github.com/Cap-go/simple-fest">GitHub</a>
        <a href="/support/">Support</a>
        <a href="/privacy/">Privacy</a>
      </nav>
    </footer>
  </body>
</html>

<style is:global>
  /* Same tokens as the app (src/index.css): iOS greys, black ink, color only for scan results. */
  :root {
    color-scheme: light dark;
    --bg: #f2f2f7;
    --surface: #ffffff;
    --surface-2: #e9e9ef;
    --ink: #111111;
    --ink-contrast: #ffffff;
    --muted: #6e6e73;
    --line: rgba(15, 23, 42, 0.08);
    --success: #15803d;
    --warning: #d97706;
    --danger: #dc2626;
    --radius: 18px;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #000000;
      --surface: #1c1c1e;
      --surface-2: #2c2c2e;
      --ink: #f5f5f7;
      --ink-contrast: #111111;
      --muted: #8e8e93;
      --line: rgba(255, 255, 255, 0.08);
      --success: #22c55e;
      --warning: #f59e0b;
      --danger: #f87171;
    }
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, system-ui, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  .wrap,
  .bar,
  footer {
    width: min(1080px, calc(100% - 32px));
    margin: 0 auto;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
  }

  .brand img {
    border-radius: 8px;
  }

  .bar nav,
  footer nav {
    display: flex;
    gap: 18px;
  }

  .bar nav a,
  footer a {
    color: var(--muted);
    font-weight: 600;
    text-decoration: none;
  }

  .bar nav a:hover,
  footer a:hover {
    color: var(--ink);
  }

  .card {
    background: var(--surface);
    border-radius: var(--radius);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 22px;
    border: 0;
    border-radius: 999px;
    background: var(--ink);
    color: var(--ink-contrast);
    font: inherit;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }

  .pill.ghost {
    background: var(--surface);
    color: var(--ink);
  }

  .pill svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
  }

  .pill small {
    display: block;
    font-size: 0.7rem;
    font-weight: 500;
    opacity: 0.75;
    line-height: 1;
  }

  .pill span {
    text-align: left;
    line-height: 1.15;
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding: 28px 0 40px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.92rem;
  }
</style>
