---
const { title, description } = Astro.props as { title: string; description: string }
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} - Simple Fest</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main>
      <a class="back" href="/">Simple Fest</a>
      <h1>{title}</h1>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --ink: #0f172a;
    --muted: #5b6678;
    --paper: #f4f6f8;
    --accent: #0f766e;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --ink: #e8edf4;
      --muted: #97a3b6;
      --paper: #0b1220;
      --accent: #2dd4bf;
    }
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    line-height: 1.6;
  }

  main {
    width: min(720px, calc(100% - 40px));
    margin: 0 auto;
    padding: 48px 0 80px;
  }

  h1 {
    margin: 16px 0 8px;
    font-size: 2.2rem;
    line-height: 1.1;
  }

  h2 {
    margin-top: 32px;
    font-size: 1.2rem;
  }

  p,
  li {
    color: var(--muted);
  }

  a {
    color: var(--accent);
  }

  .back {
    font-weight: 700;
    text-decoration: none;
  }
</style>
