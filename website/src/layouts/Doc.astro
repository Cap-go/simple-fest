---
import Base from './Base.astro'

const { title, description } = Astro.props as { title: string; description: string }
---
<Base title={`${title} - Simple Fest`} description={description}>
  <main class="wrap doc card">
    <h1>{title}</h1>
    <slot />
  </main>
</Base>

<style is:global>
  .doc {
    max-width: 760px;
    margin-bottom: 48px;
    padding: clamp(24px, 5vw, 48px);
  }

  .doc h1 {
    margin-bottom: 8px;
    font-size: 2rem;
    line-height: 1.1;
  }

  .doc h2 {
    margin: 32px 0 8px;
    font-size: 1.15rem;
  }

  .doc p,
  .doc li {
    color: var(--muted);
  }

  .doc a {
    color: var(--ink);
    font-weight: 600;
  }
</style>
