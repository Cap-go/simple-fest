---
import Base from '../layouts/Base.astro'

const appStore = 'https://apps.apple.com/app/id6821213687'
const testFlight = 'https://testflight.apple.com/join/96fhnG3a'
const googlePlay = 'https://play.google.com/store/apps/details?id=ee.forgr.festivalscan'

const steps = [
  ['Import your list', 'CSV, Excel or a Google Sheet. Names, emails and what each person paid. Columns are detected for you.', '/screens/01-import.jpg', 'Import screen'],
  ['Scan at the door', 'Green means in. Orange means already used. Red means not paid. Works offline.', '/screens/03-scan-result.jpg', 'Accepted scan for Ada Lovelace'],
  ['Add more phones', 'Show a QR on the first phone, scan it on the next. Scans sync when the network is back.', '/screens/05-device-sync.jpg', 'Device sync invite QR'],
]
---
<Base title="Simple Fest - free, open-source ticket scanner for small events" description="Turn your guest list into a QR ticket scanner. Free and open source, works offline, no account. Built for small festivals, parties and community events.">
  <main>
    <section class="wrap hero">
      <div class="copy">
        <h1>Check guests in from a spreadsheet.</h1>
        <p class="lead">
          Simple Fest turns the list of who paid into a ticket scanner for the gate, the bar and the food stand. Free and open source. Works offline, no account.
        </p>
        <div class="stores">
          <a class="pill" href={appStore} rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.37 12.6c-.02-2.3 1.88-3.4 1.96-3.46-1.07-1.56-2.73-1.78-3.32-1.8-1.41-.14-2.76.83-3.47.83-.72 0-1.82-.81-3-.79-1.54.02-2.96.9-3.76 2.27-1.6 2.78-.41 6.9 1.15 9.16.76 1.1 1.67 2.34 2.86 2.3 1.15-.05 1.58-.74 2.97-.74 1.38 0 1.77.74 2.98.72 1.23-.02 2.01-1.12 2.76-2.23.87-1.28 1.23-2.52 1.25-2.58-.03-.01-2.4-.92-2.42-3.65zM14.1 5.86c.63-.77 1.06-1.83.94-2.89-.91.04-2.01.61-2.66 1.37-.58.67-1.1 1.75-.96 2.79 1.01.08 2.05-.52 2.68-1.27z"/></svg>
            <span><small>Download on the</small>App Store</span>
          </a>
          <a class="pill" href={testFlight} rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.2 10.7 21.2 3.4c.6-.2 1.2.4.9 1L15.6 21c-.2.6-1.1.7-1.4.1l-2.9-5.5-5.5-2.9c-.6-.3-.5-1.2.1-1.4l-3.7-.6zm7.4 1.7 2.2 4.1 3.8-10.2-10.2 3.8 4.2 2.3z"/></svg>
            <span><small>Try the iOS beta</small>TestFlight</span>
          </a>
          <a class="pill" href={googlePlay} rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.6 2.3c-.2.2-.3.6-.3 1v17.4c0 .4.1.8.3 1l9.7-9.7L3.6 2.3zm10.8 10.8 2.8 2.8-11.9 6.8c-.4.2-.8.3-1.1.2l10.2-9.8zm4.1-4.1 3 1.7c.9.5.9 1.4 0 1.9l-3 1.7-3-3 3-2.3zM5.3 1.9l11.9 6.8-2.8 2.8L4.2 1.7c.3-.1.7 0 1.1.2z"/></svg>
            <span><small>Get it on</small>Google Play</span>
          </a>
        </div>
        <ul class="facts">
          <li>Free for every event</li>
          <li>Works without internet</li>
          <li>Your list stays on your phones</li>
        </ul>
        <p class="source"><a href="https://github.com/Cap-go/simple-fest">View the source on GitHub</a></p>
      </div>
      <div class="phone">
        <video src="/video/demo.mp4" poster="/video/poster.jpg" autoplay muted loop playsinline aria-label="Simple Fest demo: scanning guests at the entrance"></video>
      </div>
    </section>

    <section class="wrap story card">
      <h2>Made for the events big ticket apps forget.</h2>
      <p>
        This summer I helped run a small event. Our tickets were a spreadsheet of names and who had paid. Ticket platforms cost too much for one weekend, so I built this to check people in at the gate and the bar. It worked, so now it is free for everyone.
      </p>
    </section>

    <section class="wrap steps">
      {steps.map(([title, text, src, alt], index) => (
        <article class="card">
          <span class="num">{index + 1}</span>
          <h3>{title}</h3>
          <p>{text}</p>
          <img src={src} alt={alt} loading="lazy" width="660" height="1434" />
        </article>
      ))}
    </section>

    <section id="ticket" class="wrap ticket card">
      <div>
        <h2>No QR codes yet? Use emails.</h2>
        <p>
          Simple Fest can find guests by email. Type a guest's email to make their QR ticket, then send it to them. Scan it at the door and the app finds them in your list.
        </p>
        <p class="note">Made in your browser. The email is not sent anywhere.</p>
        <form id="ticket-form">
          <label for="ticket-email">Guest email</label>
          <div class="row">
            <input id="ticket-email" type="email" required placeholder="guest@example.com" autocomplete="off" />
            <button class="pill" type="submit">Make ticket</button>
          </div>
          <label for="ticket-event">Event name (optional)</label>
          <input id="ticket-event" type="text" placeholder="Summer Fest 2026" autocomplete="off" />
        </form>
      </div>
      <div class="ticket-out" id="ticket-out" hidden>
        <canvas id="ticket-canvas" width="720" height="960" aria-label="Generated QR ticket"></canvas>
        <a class="pill" id="ticket-download" download="ticket.png" href="#">Download PNG</a>
      </div>
    </section>
  </main>
</Base>

<script>
  import { toCanvas } from 'qrcode'

  const form = document.getElementById('ticket-form') as HTMLFormElement
  const email = document.getElementById('ticket-email') as HTMLInputElement
  const eventName = document.getElementById('ticket-event') as HTMLInputElement
  const out = document.getElementById('ticket-out') as HTMLDivElement
  const canvas = document.getElementById('ticket-canvas') as HTMLCanvasElement
  const download = document.getElementById('ticket-download') as HTMLAnchorElement

  form.addEventListener('submit', async (event) => {
    event.preventDefault()
    const value = email.value.trim().toLowerCase()
    if (!value) return

    const qr = document.createElement('canvas')
    await toCanvas(qr, value, { width: 560, margin: 1, errorCorrectionLevel: 'M' })

    const ctx = canvas.getContext('2d')!
    ctx.fillStyle = '#ffffff'
    ctx.fillRect(0, 0, canvas.width, canvas.height)
    ctx.fillStyle = '#111111'
    ctx.textAlign = 'center'
    ctx.font = '700 40px -apple-system, system-ui, sans-serif'
    ctx.fillText(eventName.value.trim() || 'Your ticket', 360, 90)
    ctx.drawImage(qr, 80, 140)
    ctx.fillStyle = '#6e6e73'
    ctx.font = '500 28px -apple-system, system-ui, sans-serif'
    ctx.fillText(value, 360, 770, 640)
    ctx.font = '500 22px -apple-system, system-ui, sans-serif'
    ctx.fillText('Show this QR at the entrance', 360, 830)

    download.href = canvas.toDataURL('image/png')
    download.download = `ticket-${value.replace(/[^a-z0-9]+/g, '-')}.png`
    out.hidden = false
  })
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(260px, 0.9fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
    padding: clamp(24px, 6vw, 72px) 0;
  }

  h1 {
    margin-bottom: 18px;
    font-size: clamp(2.6rem, 6.4vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  h2 {
    margin-bottom: 12px;
    font-size: clamp(1.5rem, 3.4vw, 2.2rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .lead {
    max-width: 560px;
    color: var(--muted);
    font-size: clamp(1.08rem, 2vw, 1.3rem);
  }

  .stores {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 28px 0 22px;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .facts li {
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 600;
  }

  .phone {
    justify-self: center;
    width: min(340px, 100%);
    padding: 10px;
    border-radius: 48px;
    background: #111111;
  }

  .source {
    margin: 18px 0 0;
    font-weight: 600;
  }

  .phone video {
    display: block;
    width: 100%;
    aspect-ratio: 390 / 844;
    border-radius: 38px;
    background: #f2f2f7;
    object-fit: cover;
  }

  .story {
    padding: clamp(24px, 5vw, 44px);
    margin-bottom: 20px;
  }

  .story p {
    max-width: 760px;
    margin: 0;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-bottom: 20px;
  }

  .steps article {
    display: flex;
    flex-direction: column;
    padding: 24px 24px 0;
    overflow: hidden;
  }

  .num {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-bottom: 14px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--ink-contrast);
    font-weight: 700;
  }

  .steps h3 {
    margin-bottom: 6px;
    font-size: 1.2rem;
  }

  .steps p {
    color: var(--muted);
  }

  .steps img {
    display: block;
    width: 86%;
    height: auto;
    margin: auto auto 0;
    border-radius: 24px 24px 0 0;
    border: 1px solid var(--line);
    border-bottom: 0;
  }

  .ticket {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 300px);
    gap: 32px;
    align-items: start;
    padding: clamp(24px, 5vw, 44px);
    margin-bottom: 48px;
    scroll-margin-top: 16px;
  }

  .ticket p {
    max-width: 560px;
    color: var(--muted);
  }

  .note {
    font-size: 0.9rem;
  }

  form {
    display: grid;
    gap: 8px;
    max-width: 520px;
    margin-top: 20px;
  }

  label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 8px;
  }

  input {
    flex: 1 1 220px;
    min-height: 52px;
    padding: 0 20px;
    border: 0;
    border-radius: 999px;
    background: var(--bg);
    color: var(--ink);
    font: inherit;
  }

  input:focus-visible,
  .pill:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }

  .ticket-out {
    display: grid;
    gap: 12px;
  }

  .ticket-out[hidden] {
    display: none;
  }

  canvas {
    width: 100%;
    height: auto;
    border-radius: 16px;
    border: 1px solid var(--line);
  }

  @media (max-width: 860px) {
    .hero,
    .steps,
    .ticket {
      grid-template-columns: 1fr;
    }

    .steps img {
      width: 70%;
    }
  }
</style>
