{
  "name": "simple-festival",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "website"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build && bunx cap copy",
    "lint": "vue-tsc -b && eslint .",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "store:screenshots": "bun scripts/generate-store-screenshots.ts",
    "store:creative": "bun scripts/generate-store-creative.ts",
    "cap:sync": "bunx cap sync",
    "website:dev": "bun --cwd website dev",
    "website:build": "bun --cwd website build",
    "website:preview": "bun --cwd website preview",
    "build:all": "bun run build && bun run website:build",
    "worker:dev": "bunx wrangler@latest dev",
    "worker:deploy": "bunx wrangler@latest deploy",
    "worker:types": "bunx wrangler@latest types worker/src/worker-configuration.d.ts"
  },
  "dependencies": {
    "@capacitor/app": "latest",
    "@capacitor/clipboard": "latest",
    "@capacitor/core": "latest",
    "@capacitor/filesystem": "latest",
    "@capacitor/haptics": "latest",
    "@capacitor/keyboard": "latest",
    "@capacitor/share": "latest",
    "@capacitor/splash-screen": "latest",
    "@capacitor/status-bar": "latest",
    "@capgo/camera-preview": "latest",
    "@capgo/capacitor-in-app-review": "latest",
    "@capgo/capacitor-keep-awake": "latest",
    "@capgo/capacitor-native-navigation": "latest",
    "@capgo/capacitor-updater": "latest",
    "@capgo/native-audio": "latest",
    "@ionic/vue": "latest",
    "@ionic/vue-router": "latest",
    "ionicons": "latest",
    "papaparse": "latest",
    "qrcode": "latest",
    "vue": "latest",
    "vue-router": "latest",
    "xlsx": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@capacitor/android": "latest",
    "@capacitor/cli": "latest",
    "@capacitor/ios": "latest",
    "@eslint/js": "latest",
    "@types/node": "latest",
    "@types/papaparse": "latest",
    "@types/qrcode": "latest",
    "@vitejs/plugin-vue": "latest",
    "@vue/compiler-sfc": "latest",
    "eslint": "latest",
    "eslint-plugin-vue": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "playwright": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest",
    "vue-tsc": "latest",
    "wrangler": "latest"
  }
}
